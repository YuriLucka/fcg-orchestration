# Copie para .env e preencha. Nunca versione o .env.
# MSSQL_SA_PASSWORD: 12+ caracteres com maiúscula, minúscula, número e símbolo; sem espaço, $, aspas ou ;
MSSQL_SA_PASSWORD=
# JWT_SECRET: 32+ caracteres (mesmo valor para users-api, catalog-api e Kong)
JWT_SECRET=
RABBIT_USER=
RABBIT_PASS=
RABBIT_ERLANG_COOKIE=
GRAFANA_ADMIN_PASSWORD=
# Local: http://elasticsearch:9200 (sem ApiKey). Nuvem: endpoint do Elastic Cloud + ApiKey.
ES_URL=http://elasticsearch:9200
ES_APIKEY=
